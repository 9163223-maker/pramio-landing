Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonicalize the public host first. The destination is fixed so an
  # arbitrary Host header can never be reflected into Location.
  RewriteCond %{HTTP_HOST} !^pramio\.ru$ [NC]
  RewriteRule ^(.*)$ https://pramio.ru/$1 [R=301,L]

  # Then force HTTPS on the canonical host, honoring Timeweb's proxy flag.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-HTTPS} !1
  RewriteRule ^(.*)$ https://pramio.ru/$1 [R=301,L]

  # Canonical trailing slash for extensionless directory requests, explicitly
  # preserving HTTPS instead of relying on mod_dir to construct the Location.
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[^/]+$
  RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI} -d
  RewriteRule ^(.+)$ https://pramio.ru/$1/ [R=301,L]

  # Implementation endpoint is internal; only /sitemap.xml is public.
  RewriteCond %{THE_REQUEST} \s/+sitemap-live\.php(?:[?\s]) [NC]
  RewriteRule ^sitemap-live\.php$ - [R=404,L]

  # Internal XML base is read by PHP from disk, not exposed as another sitemap.
  RewriteCond %{THE_REQUEST} \s/+sitemap-base\.xml(?:[?\s]) [NC]
  RewriteRule ^sitemap-base\.xml$ - [R=404,L]

  # Keep the registered sitemap URL stable while adding due articles server-side.
  RewriteRule ^sitemap\.xml$ /sitemap-live.php [END]

  # Block direct PHP implementation URLs while allowing internal rewrites.
  RewriteCond %{THE_REQUEST} \s/+scheduled-article\.php(?:[?\s]) [NC]
  RewriteRule ^scheduled-article\.php$ - [R=404,L]
  RewriteCond %{THE_REQUEST} \s/+blog/tetya-lida/index\.php(?:[?\s]) [NC]
  RewriteRule ^blog/tetya-lida/index\.php$ - [R=404,L]

  # Server-rendered TLZ hub: publication-aware links in initial HTML.
  RewriteRule ^blog/tetya-lida/?$ /blog/tetya-lida/index.php [END]

  # Canonical trailing slash for virtual scheduled TLZ article URLs.
  RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^blog/tetya-lida/([a-z0-9-]+)$ https://pramio.ru/blog/tetya-lida/$1/ [R=301,L]

  # Scheduled TLZ articles are rendered server-side from the protected queue.
  # The router returns a real 404 before publish_at and indexable HTML after it.
  RewriteCond %{DOCUMENT_ROOT}/blog/tetya-lida/$1/index.html !-f
  RewriteRule ^blog/tetya-lida/([a-z0-9-]+)/?$ /scheduled-article.php?slug=$1 [END,QSA]

  # Normalize explicit index.html paths to their directory URL. This also
  # removes the duplicate showroom/legal/index.html URL without indexing demos.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
  RewriteRule ^(.*/)?index\.html$ https://pramio.ru/$1 [R=301,L]

</IfModule>

AddType image/webp .webp
AddType image/avif .avif
AddType application/javascript .js
AddCharset UTF-8 .js

<FilesMatch "^(config\.local\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    Satisfy All
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000"

  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>

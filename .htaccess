Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType image/webp .webp
AddType image/avif .avif

<FilesMatch "^(config\.local\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
    Satisfy All
  </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt|php)$">
    Header set Cache-Control "public, max-age=300"
  </FilesMatch>
</IfModule>
